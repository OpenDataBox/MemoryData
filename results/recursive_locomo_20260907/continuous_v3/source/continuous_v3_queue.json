    {
      "name": "r13_extractive_cards",
      "parent": "seed",
      "operations": [
        {
          "op": "extract",
          "window": 10,
          "overlap": 2,
          "limit": 28,
          "max_tokens": 1200,
          "prompt": "Construct long-term memory only from this dialogue. Output at most 28 short, specific records, one per line, each starting with exact supporting source IDs [D1:2,D1:3]. Format each record as SUBJECT | specific event or attribute | VALUE. Use the correct named person as SUBJECT; do not swap speaker and listener. VALUE should copy the shortest complete exact wording from the speaker whenever possible, retaining all items in a stated list. Include names, titles, family and pet relationships, activities, places, reasons, reactions and evaluations, plans versus completed events, and each original time expression. Resolve short answers from the immediately preceding question. Separate unrelated events; keep each event and its time together. Omit generic encouragement, greetings and thanks. Never invent facts, outside knowledge, dates, names or sources. Preserve image descriptions only when they explain a shared object. No prose outside the records."
        }
      ]
    },
