    {
      "name": "r16_declarative_facts",
      "parent": "seed",
      "operations": [
        {
          "op": "extract",
          "window": 12,
          "overlap": 2,
          "limit": 28,
          "max_tokens": 1200,
          "prompt": "Extract all useful autobiographical facts from this dialogue window. Write at most 28 atomic, self-contained sentences, each beginning with exact source IDs [D1:2,D1:3]. Keep the speaker's original content words, names, titles, quantities and list items, while replacing pronouns with the correct named person. Write simple direct sentences, not descriptions such as 'mentioned', 'discussed', 'expressed interest' unless uncertainty really requires it. Preserve an exact evaluative word such as 'amazing' instead of paraphrasing it. Record facts about each person separately and distinguish the person who owns or did something from a person asking about it. Resolve short responses using adjacent dialogue. Keep original relative dates, plans, uncertainty, negation, and all historical states; do not infer unstated dates. Omit generic supportive chatter, salutations and thanks. Only supported dialogue facts; no outside knowledge. No preamble."
        }
      ]
    },
